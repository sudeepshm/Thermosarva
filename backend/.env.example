# ── FortyGuard (Environmental Intelligence) ──────────────────────────────────
FORTYGUARD_API_KEY=your_fortyguard_api_key_here
FORTYGUARD_BASE_URL=https://api.fortyguard.com/v1
# Production must be false and must include a real FortyGuard API key.
# Local development can set this to true for deterministic stub data.
FORTYGUARD_STUB_MODE=false

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default for local dev — zero setup required)
DATABASE_URL=sqlite+aiosqlite:///./thermosarva.db
# PostgreSQL (production — uncomment and fill)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/thermosarva

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
# Set to "true" to use an in-memory dict cache when Redis is unavailable
REDIS_FALLBACK_MEMORY=true

# ── Geographic Services (Free / Open) ────────────────────────────────────────
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=thermosarva/1.0 (contact@thermosarva.com)
OVERPASS_BASE_URL=https://overpass-api.de/api

# ── NOAA National Weather Service ────────────────────────────────────────────
NWS_BASE_URL=https://api.weather.gov

# ── OpenAQ (Optional air-quality fallback) ───────────────────────────────────
OPENAQ_API_KEY=
OPENAQ_BASE_URL=https://api.openaq.org/v3

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173
SECRET_KEY=change_this_to_a_random_secret_in_production
